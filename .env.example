# Copy to .env and fill in real values — never commit .env

# Local dev
# Database
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5432

# AI provider profile: gemini | anthropic | openai  (default: gemini)
AI_PROVIDER=gemini
GEMINI_API_KEY=

# Uncomment if AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:4200

# Production (server .env)
# Copy the block below to ~/muolana/.env on the server

# DOMAIN=muolana.example.com
# GITHUB_OWNER=your-github-username

# DB_NAME=muolana
# DB_USER=muolana
# DB_PASSWORD=<strong-password>

# MINIO_ACCESS_KEY=<access-key>
# MINIO_SECRET_KEY=<strong-secret>
# MINIO_BUCKET=muolana-documents

# AI_PROVIDER=gemini
# GEMINI_API_KEY=<api-key>
# ANTHROPIC_API_KEY=   # leave blank if not used

# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=<strong-password>
# ADMIN_FULL_NAME=System Admin

# CORS_ORIGINS=https://muolana.example.com

# GitHub Actions secrets
# Set these in: Settings → Secrets and variables → Actions
#
#   DEPLOY_KEY    — contents of the SSH private key for server access
#   SERVER_HOST   — server IP or hostname
#   SERVER_USER   — SSH user (e.g. admin)

# Server setup (first deploy only)
# 1. Install Docker + Docker Compose on the server.
# 2. mkdir -p ~/muolana/secrets
# 3. Copy public.pem and private.pem to ~/muolana/secrets/
# 4. Copy .env (filled in) to ~/muolana/.env
# 5. Copy docker-compose.prod.yml and nginx/ to ~/muolana/
# 6. Issue TLS certs:
#      certbot certonly --webroot -w /var/www/certbot -d muolana.example.com
# 7. Run: docker compose -f docker-compose.prod.yml up -d
# 8. Subsequent deploys are handled automatically by the GitHub Actions workflow.

# Copy to .env and fill in real values — never commit .env

# Database
DB_NAME=muolana
DB_USER=muolana
DB_PASSWORD=changeme
DB_PORT=5432

# Application
APP_PORT=8080

# JWT
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Path to directory that holds public.pem and private.pem
# Default points to the dev-time generated keys inside src/main/resources/certs/
CERTS_DIR=./src/main/resources/certs

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:3000

# Anthropic — chat / LLM inference (required)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI — embeddings only, text-embedding-3-small
GEMINI_API_KEY=
